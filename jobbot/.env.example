# Destination email for end-of-run reports (also settable in Settings UI)
JOBBOT_REPORT_EMAIL=

# CV — defaults to bundled assets/cv/matan-amar-cv.pdf (seeded from Project store)
JOBBOT_CV_PATH=

# Chrome profile (user logs into sites themselves — no passwords in Jobbot)
JOBBOT_CHROME_PROFILE=

# App-owned mailer (NOT user SMTP). Set by the Jobbot install / maintainer:
JOBBOT_MAIL_API_KEY=
JOBBOT_MAIL_FROM=Jobbot <noreply@yourdomain.com>
# Optional fallback relay:
# JOBBOT_MAIL_SMTP_HOST=
# JOBBOT_MAIL_SMTP_PORT=587
# JOBBOT_MAIL_SMTP_USER=
# JOBBOT_MAIL_SMTP_PASS=
# JOBBOT_MAIL_SMTP_FROM=

# Offline demo without real browser automation
JOBBOT_DEMO=1
