{
  "name": "jobbot",
  "version": "0.1.0",
  "description": "Jobbot — אוטומציית חיפוש והגשת משרות מקומית עבור מתן עמר",
  "main": "dist-electron/main.js",
  "author": "Matan Amar",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "demo": "JOBBOT_DEMO=1 vite",
    "demo:run": "JOBBOT_DEMO=1 tsx scripts/demo-run.ts",
    "start": "electron ."
  },
  "dependencies": {
    "nodemailer": "^6.9.16",
    "pdf-parse": "^1.1.1",
    "playwright": "^1.49.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
