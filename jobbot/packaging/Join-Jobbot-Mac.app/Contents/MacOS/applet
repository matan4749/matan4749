#!/usr/bin/osascript
-- Prefer .tar.gz.part → Jobbot-mac.tar.gz → tar extract Jobbot.app
-- Fallback: legacy .zip.part → unzip

on posixExists(p)
	try
		do shell script "/bin/test -f " & quoted form of p
		return true
	on error
		return false
	end try
end posixExists

on dirExists(p)
	try
		do shell script "/bin/test -d " & quoted form of p
		return true
	on error
		return false
	end try
end dirExists

on ensureSlash(p)
	if p ends with "/" then return p
	return p & "/"
end ensureSlash

on hasTarParts(folderPath)
	set p0 to folderPath & "Jobbot-0.1.0-mac-arm64.tar.gz.part00"
	set p1 to folderPath & "Jobbot-0.1.0-mac-arm64.tar.gz.part01"
	set p2 to folderPath & "Jobbot-0.1.0-mac-arm64.tar.gz.part02"
	return posixExists(p0) and posixExists(p1) and posixExists(p2)
end hasTarParts

on hasZipParts(folderPath)
	set p0 to folderPath & "Jobbot-0.1.0-mac-arm64.zip.part00"
	set p1 to folderPath & "Jobbot-0.1.0-mac-arm64.zip.part01"
	set p2 to folderPath & "Jobbot-0.1.0-mac-arm64.zip.part02"
	return posixExists(p0) and posixExists(p1) and posixExists(p2)
end hasZipParts

-- returns "tar" | "zip" | ""
on partsKindIn(folderPath)
	if hasTarParts(folderPath) then return "tar"
	if hasZipParts(folderPath) then return "zip"
	return ""
end partsKindIn

on corruptMsg()
	return "הקובץ פגום אחרי חיבור החלקים." & return & return & ¬
		"מחק Jobbot-mac.tar.gz / Jobbot-mac.zip ואת ה-.part הישנים," & return & ¬
		"הורד שוב את שלושת Jobbot-…tar.gz.part מאותו ביילד, ונסה שוב."
end corruptMsg

on tarHint()
	return "cd ~/Desktop/Jobbot && cat Jobbot-0.1.0-mac-arm64.tar.gz.part00 Jobbot-0.1.0-mac-arm64.tar.gz.part01 Jobbot-0.1.0-mac-arm64.tar.gz.part02 > Jobbot-mac.tar.gz && tar -tzf Jobbot-mac.tar.gz && tar -xzf Jobbot-mac.tar.gz && open -R Jobbot.app"
end tarHint

on run
	set homePath to ensureSlash(POSIX path of (path to home folder))
	set searched to {}
	set found to ""
	set kind to ""

	set candidates to {¬
		homePath & "Downloads/", ¬
		homePath & "Desktop/", ¬
		homePath & "Downloads/Jobbot/", ¬
		homePath & "Desktop/Jobbot/", ¬
		homePath & "הורדות/", ¬
		homePath & "שולחן העבודה/", ¬
		homePath & "Library/Mobile Documents/com~apple~CloudDocs/Downloads/", ¬
		homePath & "Library/Mobile Documents/com~apple~CloudDocs/Desktop/"}

	try
		set appPath to POSIX path of (path to me)
		set appPath to ensureSlash(appPath)
		if appPath does not contain "AppTranslocation" and appPath does not contain "TemporaryItems" then
			set parentCmd to "dirname " & quoted form of (text 1 thru -2 of appPath)
			set parentDir to ensureSlash(do shell script parentCmd)
			set beginning of candidates to parentDir
		end if
	end try

	repeat with d in candidates
		set dPosix to d as text
		set end of searched to dPosix
		if dirExists(dPosix) then
			set k to partsKindIn(dPosix)
			if k is not "" then
				set found to dPosix
				set kind to k
				exit repeat
			end if
		end if
	end repeat

	if found is "" then
		try
			set theFolder to choose folder with prompt "בחר תיקייה עם Jobbot-…tar.gz.part00/01/02:"
			set found to ensureSlash(POSIX path of theFolder)
			set kind to partsKindIn(found)
			if kind is "" then set found to ""
		on error
			set found to ""
		end try
	end if

	if found is "" then
		display dialog "לא נמצאו קבצי .tar.gz.part" & return & return & ¬
			"חובה להוריד:" & return & ¬
			"• Jobbot-0.1.0-mac-arm64.tar.gz.part00" & return & ¬
			"• Jobbot-0.1.0-mac-arm64.tar.gz.part01" & return & ¬
			"• Jobbot-0.1.0-mac-arm64.tar.gz.part02" & return & return & ¬
			"(לא .zip.part — אלא אם אין tar.gz)" & return & return & ¬
			"Terminal:" & return & my tarHint() & return & return & ¬
			"⚠️ אסור ללחוץ פעמיים על הארכיון ב-Finder." buttons {"אישור"} default button 1 with title "Jobbot" with icon stop
		return
	end if

	if kind is "tar" then
		my joinTar(found)
	else
		my joinZip(found)
	end if
end run

on joinTar(found)
	set outFile to found & "Jobbot-mac.tar.gz"
	set joinCmd to "cd " & quoted form of found & " && /bin/rm -f Jobbot-mac.tar.gz Jobbot-mac.zip && /bin/cat Jobbot-0.1.0-mac-arm64.tar.gz.part00 Jobbot-0.1.0-mac-arm64.tar.gz.part01 Jobbot-0.1.0-mac-arm64.tar.gz.part02 > Jobbot-mac.tar.gz"
	try
		do shell script joinCmd
	on error errMsg
		display dialog "שגיאה בחיבור:" & return & errMsg buttons {"אישור"} default button 1 with title "Jobbot" with icon stop
		return
	end try

	try
		set magic to do shell script "dd if=" & quoted form of outFile & " bs=2 count=1 2>/dev/null | od -An -tx1 | tr -d ' \\n'"
		if magic is not "1f8b" then error "bad magic"
	on error
		do shell script "/bin/rm -f " & quoted form of outFile
		display dialog my corruptMsg() & return & return & "Terminal:" & return & my tarHint() buttons {"אישור"} default button 1 with title "Jobbot — פגום" with icon stop
		return
	end try

	try
		do shell script "/usr/bin/tar -tzf " & quoted form of outFile & " >/dev/null"
	on error
		do shell script "/bin/rm -f " & quoted form of outFile
		display dialog my corruptMsg() & return & return & "Terminal:" & return & my tarHint() buttons {"אישור"} default button 1 with title "Jobbot — פגום" with icon stop
		return
	end try

	try
		do shell script "cd " & quoted form of found & " && /bin/rm -rf Jobbot.app && /usr/bin/tar -xzf Jobbot-mac.tar.gz"
	on error errMsg
		display dialog "חילוץ נכשל:" & return & errMsg & return & return & my corruptMsg() & return & return & "Terminal:" & return & my tarHint() buttons {"אישור"} default button 1 with title "Jobbot" with icon stop
		return
	end try

	set appOut to found & "Jobbot.app"
	if not dirExists(appOut) then
		display dialog my corruptMsg() & return & return & "Terminal:" & return & my tarHint() buttons {"אישור"} default button 1 with title "Jobbot" with icon stop
		return
	end if

	display dialog "✅ Jobbot.app מוכן!" & return & found & return & return & ¬
		"⚠️ אל תלחץ פעמיים על Jobbot-mac.tar.gz — רק על Jobbot.app" & return & ¬
		"(לחיצה ימנית ← פתח אם חוסמים)" buttons {"הצג את Jobbot.app"} default button 1 with title "Jobbot מוכן"
	try
		do shell script "/usr/bin/open -R " & quoted form of appOut
	end try
end joinTar

on joinZip(found)
	-- Legacy fallback only
	set outFile to found & "Jobbot-mac.zip"
	set joinCmd to "cd " & quoted form of found & " && /bin/rm -f Jobbot-mac.zip && /bin/cat Jobbot-0.1.0-mac-arm64.zip.part00 Jobbot-0.1.0-mac-arm64.zip.part01 Jobbot-0.1.0-mac-arm64.zip.part02 > Jobbot-mac.zip"
	try
		do shell script joinCmd
		do shell script "/usr/bin/unzip -t " & quoted form of outFile
		do shell script "cd " & quoted form of found & " && /bin/rm -rf Jobbot.app && /usr/bin/unzip -o -q Jobbot-mac.zip"
	on error errMsg
		display dialog "כישלון ב-zip ישן:" & return & errMsg & return & return & ¬
			"עדיף להוריד .tar.gz.part החדשים." & return & return & ¬
			"Terminal:" & return & my tarHint() buttons {"אישור"} default button 1 with title "Jobbot" with icon stop
		return
	end try
	set appOut to found & "Jobbot.app"
	display dialog "Jobbot.app מחולץ (מ-zip ישן)." & return & ¬
		"מומלץ לעבור ל-.tar.gz.part בביילד הבא." buttons {"הצג"} default button 1 with title "Jobbot"
	try
		do shell script "/usr/bin/open -R " & quoted form of appOut
	end try
end joinZip
