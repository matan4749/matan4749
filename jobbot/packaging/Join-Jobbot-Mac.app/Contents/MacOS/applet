#!/usr/bin/osascript
-- Join Jobbot Mac parts, verify zip, extract with unzip (avoids Archive Utility Error 94)

on posixExists(p)
	try
		do shell script "/bin/test -f " & quoted form of p
		return true
	on error
		return false
	end try
end posixExists

on dirExists(p)
	try
		do shell script "/bin/test -d " & quoted form of p
		return true
	on error
		return false
	end try
end dirExists

on partsIn(folderPath)
	set p0 to folderPath & "Jobbot-0.1.0-mac-arm64.zip.part00"
	set p1 to folderPath & "Jobbot-0.1.0-mac-arm64.zip.part01"
	set p2 to folderPath & "Jobbot-0.1.0-mac-arm64.zip.part02"
	if posixExists(p0) and posixExists(p1) and posixExists(p2) then
		return true
	end if
	return false
end partsIn

on ensureSlash(p)
	if p ends with "/" then return p
	return p & "/"
end ensureSlash

on corruptMsg()
	return "הקובץ פגום אחרי חיבור החלקים." & return & return & ¬
		"מחק את Jobbot-mac.zip ואת שלושת קבצי ה-.part הישנים," & return & ¬
		"הורד שוב את שלושת החלקים מאותו ביילד, ונסה שוב."
end corruptMsg

on run
	set homePath to ensureSlash(POSIX path of (path to home folder))
	set searched to {}
	set found to ""

	set candidates to {¬
		homePath & "Downloads/", ¬
		homePath & "Desktop/", ¬
		homePath & "Downloads/Jobbot/", ¬
		homePath & "Desktop/Jobbot/", ¬
		homePath & "הורדות/", ¬
		homePath & "שולחן העבודה/", ¬
		homePath & "Library/Mobile Documents/com~apple~CloudDocs/Downloads/", ¬
		homePath & "Library/Mobile Documents/com~apple~CloudDocs/Desktop/"}

	try
		set appPath to POSIX path of (path to me)
		set appPath to ensureSlash(appPath)
		if appPath does not contain "AppTranslocation" and appPath does not contain "TemporaryItems" then
			set parentCmd to "dirname " & quoted form of (text 1 thru -2 of appPath)
			set parentDir to ensureSlash(do shell script parentCmd)
			set beginning of candidates to parentDir
		else
			set end of searched to "(דילוג — App Translocation)"
		end if
	end try

	repeat with d in candidates
		set dPosix to d as text
		set end of searched to dPosix
		if dirExists(dPosix) then
			if partsIn(dPosix) then
				set found to dPosix
				exit repeat
			end if
		end if
	end repeat

	if found is "" then
		try
			set theFolder to choose folder with prompt "בחר את התיקייה עם שלושת קבצי החלקים (.part00 .part01 .part02):"
			set found to ensureSlash(POSIX path of theFolder)
			set end of searched to found & " (נבחר ידנית)"
			if not partsIn(found) then set found to ""
		on error
			set found to ""
		end try
	end if

	if found is "" then
		set msg to "לא נמצאו קבצי החלקים." & return & return & ¬
			"פתרון מומלץ:" & return & ¬
			"1. העבר את שלושת החלקים לתיקייה חדשה בשולחן העבודה" & return & ¬
			"2. פתח Terminal והדבק:" & return & return & ¬
			"cd ~/Desktop/Jobbot && cat Jobbot-0.1.0-mac-arm64.zip.part00 Jobbot-0.1.0-mac-arm64.zip.part01 Jobbot-0.1.0-mac-arm64.zip.part02 > Jobbot-mac.zip && unzip -t Jobbot-mac.zip && unzip -o Jobbot-mac.zip" & return & return & ¬
			"תיקיות שחיפשתי:" & return & my joinLines(searched)
		display dialog msg buttons {"אישור"} default button 1 with title "Jobbot" with icon stop
		return
	end if

	set outFile to found & "Jobbot-mac.zip"
	set joinCmd to "cd " & quoted form of found & " && /bin/rm -f Jobbot-mac.zip && /bin/cat Jobbot-0.1.0-mac-arm64.zip.part00 Jobbot-0.1.0-mac-arm64.zip.part01 Jobbot-0.1.0-mac-arm64.zip.part02 > Jobbot-mac.zip"
	try
		do shell script joinCmd
	on error errMsg
		display dialog "שגיאה בחיבור הקבצים:" & return & errMsg buttons {"אישור"} default button 1 with title "Jobbot" with icon stop
		return
	end try

	-- Verify zip magic PK\x03\x04
	try
		set magic to do shell script "dd if=" & quoted form of outFile & " bs=4 count=1 2>/dev/null | od -An -tx1 | tr -d ' \\n'"
		if magic is not "504b0304" then error "bad magic"
	on error
		do shell script "/bin/rm -f " & quoted form of outFile
		display dialog my corruptMsg() buttons {"אישור"} default button 1 with title "Jobbot — zip פגום" with icon stop
		return
	end try

	-- unzip -t
	try
		do shell script "/usr/bin/unzip -t " & quoted form of outFile
	on error
		do shell script "/bin/rm -f " & quoted form of outFile
		display dialog my corruptMsg() buttons {"אישור"} default button 1 with title "Jobbot — zip פגום" with icon stop
		return
	end try

	-- Extract with unzip (avoid Archive Utility Error 94)
	try
		do shell script "cd " & quoted form of found & " && /bin/rm -rf Jobbot.app && /usr/bin/unzip -o -q Jobbot-mac.zip"
	on error errMsg
		display dialog "ה־zip תקין אבל החילוץ נכשל:" & return & errMsg & return & return & ¬
			"נסה בטרמינל: unzip -o Jobbot-mac.zip" buttons {"הצג zip ב-Finder"} default button 1 with title "Jobbot"
		try
			do shell script "/usr/bin/open -R " & quoted form of outFile
		end try
		return
	end try

	set appOut to found & "Jobbot.app"
	display dialog "הצלחה — Jobbot.app מוכן." & return & found & return & return & ¬
		"אם macOS חוסם: לחיצה ימנית על Jobbot.app ← פתח" & return & return & ¬
		"אל תלחץ פעמיים על ה־zip ב-Archive Utility אם קיבלת Error 94 — Join כבר חילץ." buttons {"הצג ב-Finder"} default button 1 with title "Jobbot מוכן"
	try
		if posixExists(appOut & "/Contents/MacOS/Jobbot") or dirExists(appOut) then
			do shell script "/usr/bin/open -R " & quoted form of appOut
		else
			do shell script "/usr/bin/open -R " & quoted form of outFile
		end if
	end try
end run

on joinLines(lst)
	set AppleScript's text item delimiters to return
	set t to lst as text
	set AppleScript's text item delimiters to ""
	return t
end joinLines
